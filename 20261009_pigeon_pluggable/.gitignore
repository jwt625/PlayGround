# Blender build artifacts (fully regenerated by scripts/; do not commit binaries)
*.blend
*.blend1

# Generated asset library (blends, sidecar json, previews, module copy)
/assets/components/
/assets/generated_textures/

# Renders and audio output (mp4, wav, png sequences)
/outputs/
*.mp4
*.wav
*.mp3
*.aac
*.png
*.webp

# Python caches
__pycache__/
*.pyc

# OS and scratch
.DS_Store
*.log
*.jsonl
*.bak

# Downloaded references (vendor datasheets, specs, papers): keep local, track only INDEX.md
/references/**/*.pdf
/references/**/*.jpg
/references/**/*.png

# Environment build scripts: root .gitignore ignores **/env/ for virtualenvs, but these are source
!/scripts/env/
/scripts/env/__pycache__/
/scripts/env/*.pyc
!/scripts/env/*.py
