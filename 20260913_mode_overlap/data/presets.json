{
  "schemaVersion": "presets-1",
  "units": "um except explicitly named degrees/index",
  "sourcesChecked": "2026-09-13",
  "sources": {
    "corning-smf28": {
      "url": "https://www.corning.com/content/dam/corning/media/worldwide/coc/documents/Fiber/product-information-sheets/PI-1424-AEN.pdf",
      "fact": "MFD 9.2 \u00b1 0.4 um at 1310 nm; 10.4 \u00b1 0.5 um at 1550 nm. Gaussian use is an approximation."
    },
    "coherent-uhna": {
      "url": "https://www.coherent.com/resources/datasheet/components-and-accessories/specialty-optical-fibers/uhna4_spec_202011122126.pdf",
      "fact": "At 1550 nm UHNA1/3/4/7 MFD are 4.8/4.1/4.0/3.2 um, each \u00b10.3 um; not a universal HNA specification."
    },
    "imec-soi": {
      "url": "https://www.imec-int.com/drupal/sites/default/files/2019-03/IC-link%20integrated%20si-photonics%20platform_web.pdf",
      "fact": "Historical platform strip C-band width 450 nm, O-band 380 nm. Educational anchor, not current PDK rules."
    },
    "soi-220": {
      "url": "https://arxiv.org/abs/2312.13329",
      "fact": "Research describes established 220 nm SOI platform."
    },
    "ligentec-sin": {
      "url": "https://www.ligentec.com/technology/",
      "fact": "AN800/AN350/AN150 have 800/350/150 nm SiN thicknesses. Chosen game widths are independent educational assumptions."
    },
    "ln-film": {
      "url": "https://www.nature.com/articles/s41467-024-46512-4",
      "fact": "600 nm x-cut film, target 300 nm etch; paper notes actual effective etch 360 nm. Game uses idealized nominal geometry, not this exact device."
    },
    "thorlabs-lensed": {
      "url": "https://media.thorlabs.com/globalassets/family-pages/SharedAssets/s/si/single_mode_lensed_fibers_app_note.pdf",
      "fact": "Lensed-fiber spot size and working distance must be specified at the measurement plane. Game range is generic, not vendor specifications."
    }
  },
