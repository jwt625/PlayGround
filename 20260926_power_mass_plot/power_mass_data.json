{
  "metadata": {
    "title": "Power vs mass: animals, compute systems, and spacecraft",
    "units": {
      "mass": "kg",
      "power": "W"
    },
    "semantics": {
      "idle": "resting/baseline/typical-low operating power",
      "peak": "maximum measured, rated, generated, or representative peak power",
      "estimated": "if true, connector is dashed because one or both endpoints are estimated/derived rather than directly published"
    }
  },
  "sources": {
    "mammal_bmr_scaling": {
      "url": "https://www.pnas.org/doi/10.1073/pnas.0436428100",
      "note": "General mammalian BMR scaling reference; some working idle values were derived/rounded."
    },
    "mammal_mmr_scaling": {
      "url": "https://journals.biologists.com/jeb/article/208/9/1611/9373/Allometric-scaling-of-mammalian-metabolism",
      "note": "Exercise-induced MMR scaling reference; equation reported as MMR_e = 16.7 M_b^0.87 with M_b in g and MMR in mL O2/h."
    },
    "rabbit_vo2max": {
      "url": "https://pubmed.ncbi.nlm.nih.gov/19923995/",
      "note": "Rabbit VO2max ~35.1-35.8 mL/kg/min."
    },
    "sled_dog_vo2max": {
      "url": "https://journals.physiology.org/doi/full/10.1152/japplphysiol.00588.2014",
      "note": "Alaskan Husky VO2max ~198.7 mL/kg/min after training."
    },
    "atlantic_salmon": {
      "url": "https://onlinelibrary.wiley.com/doi/10.1111/jfb.14087",
      "note": "Atlantic salmon MMR ~511 mg O2/kg/h; SMR work cross-checked against related literature."
    },
    "atlantic_salmon_smr": {
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11200746/",
      "note": "Atlantic salmon SMR near ~168 mg O2/kg/h under one steady-flow condition."
    },
    "dolphin_vo2": {
      "url": "https://pubmed.ncbi.nlm.nih.gov/8340731/",
      "note": "Bottlenose dolphin VO2max 19.8-29.4 mL O2/kg/min."
    },
    "dolphin_rest": {
      "url": "https://link.springer.com/article/10.1007/s002270050575",
      "note": "Resting bottlenose dolphin metabolic rate ~2.15 W/kg."
    },
    "killer_whale_bmr": {
      "url": "https://sciences.ucf.edu/biology/PEBL/wp-content/uploads/sites/18/2013/12/2013-Worthy-et-al-MMS.pdf",
      "note": "Measured adult male killer-whale resting metabolism ~2275 W at mass 5318 kg."
    },
    "killer_whale_behavior": {
      "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0302758",
      "note": "Adult male killer-whale oxygen-consumption estimates up to 59.8 L O2/min across behaviors; used to derive representative high activity power."
    },
    "blue_whale_fmr": {
      "url": "https://link.springer.com/article/10.1007/s00360-025-01640-1",
      "note": "Estimated blue-whale field metabolic rate 2679.1 MJ/day (~31 kW)."
    },
    "blue_whale_lunge": {
      "url": "https://journals.biologists.com/jeb/article/214/1/131/10226/Mechanics-hydrodynamics-and-energetics-of-blue",
      "note": "Lunge-feeding mechanics / energetics used as basis for ~0.6 MW transient upper-end working value."
    },
    "iphone_2007": {
      "url": "https://www.apple.com/newsroom/2007/06/18iPhone-Delivers-Up-to-Eight-Hours-of-Talk-Time/",
      "note": "Apple states up to 250 h standby; working plot uses ~5.18 Wh battery / 250 h = 20.7 mW standby. Peak is an estimate."
    },
    "macintosh_128k": {
      "url": "https://support.apple.com/en-ca/112190",
      "note": "Macintosh 128K: weight 16.5 lb, max watts 60 W."
    },
    "ibm_pc_5150": {
      "url": "https://www.ibm.com/history/personal-computer",
      "note": "Mass/power values are representative historical system values; current plot treats them as estimates."
    },
    "cray_1": {
      "url": "https://en.wikipedia.org/wiki/Cray-1",
      "note": "Working values: ~5.5 t and 115 kW."
    },
    "cray_2": {
      "url": "https://en.wikipedia.org/wiki/Cray-2",
      "note": "Working values: ~2494 kg and 150-200 kW; plot uses 200 kW peak."
    },
    "eniac": {
      "url": "https://www.britannica.com/technology/ENIAC",
      "note": "Historical mass/power values are approximate; plot uses ~27.2 t and ~140 kW peak."
    },
    "dgx_b300": {
      "url": "https://docs.nvidia.com/dgx/dgxb300-user-guide/introduction-to-dgxb300.html",
      "note": "8x B300 GPUs. Busbar system mass 123 kg. Published power consumption 14.5 kW / max ~15 kW. Plot uses 19 kW as earlier working peak estimate; revise to 15 kW if strict-to-source."
    },
    "gb300_nvl72": {
      "url": "https://www.hpe.com/ca/fr/collaterals/collateral.a50009244enw.html",
      "note": "Fully loaded weight ~3300 lb (~1497 kg), 132 kW nominal TDP, ~155 kW electrical design peak."
    },
    "frontier": {
      "url": "https://www.olcf.ornl.gov/olcf-resources/compute-systems/frontier/",
      "note": "Frontier system reference; plot uses ~24.6 MW peak and ~268.6 t estimated system mass from rack count \u00d7 cabinet mass."
    },
    "frontier_mass": {
      "url": "https://www.datacenterdynamics.com/en/news/oak-ridge-upgrades-data-center-set-to-be-home-to-the-worlds-first-exascale-supercomputer-frontier/",
      "note": "Frontier cabinets ~8000 lb each; used with ~74 cabinets for mass estimate."
    },
    "summit": {
      "url": "https://www.hpcwire.com/2018/06/08/ornl-summit-supercomputer-is-officially-here/",
      "note": "Summit ~13 MW power footprint; mass estimate based on cabinet count \u00d7 ~2500 lb/cabinet."
    },
    "iss": {
      "url": "https://www.nasa.gov/international-space-station/space-station-facts-and-figures/",
      "note": "ISS mass 419,725 kg; solar generation 75-90 kW. Plot baseline ~60 kW is estimated."
    },
    "hubble": {
      "url": "https://science.nasa.gov/mission/hubble/overview/hubble-by-the-numbers/",
      "note": "Hubble weight 12,200 kg; typical use ~2100 W; arrays >5200 W."
    },
    "jwst": {
      "url": "https://science.nasa.gov/mission/webb/fact-sheet/",
      "note": "JWST total payload mass ~6200 kg. Plot uses ~2 kW available and ~1.2 kW baseline estimate."
    },
    "voyager_1": {
      "url": "https://science.nasa.gov/mission/voyager/voyager-1/",
      "note": "Voyager 1 mass 721.9 kg; 3 RTGs at ~158 W each at launch (~474 W). Plot current ~225 W baseline is a recent-era working value."
    },
    "starlink_v1": {
      "url": "https://discovery.ucl.ac.uk/10198161/1/SECESA_2024.pdf",
      "note": "Starlink V1 mass 260 kg; solar-array-based estimate ~3540 W. Baseline 1500 W is estimated."
    },
    "starlink_v2mini": {
      "url": "https://spaceflightnow.com/2023/04/19/falcon-9-starlink-6-2-coverage/",
      "note": "V2 Mini mass ~800 kg; ~116 m^2 total surface area. Plot 10/28 kW values are engineering estimates."
    },
    "starlink_v3": {
      "url": "https://starlink.com/ls/updates/starlink-version-3-satellites",
      "note": "SpaceX says V3 arrays generate approximately 2x V2 power. Plot uses 2,000 kg and 22/56 kW working estimates."
    },
    "marco": {
      "url": "https://www.jpl.nasa.gov/news/press_kits/insight/launch/appendix/mars-cube-one/",
      "note": "MarCO: 13.5 kg each; solar panels ~35 W near Earth, ~17 W near Mars. Baseline 10 W is estimated."
    },
    "planet_dove": {
      "url": "https://www.usgs.gov/centers/eros/science/planet-dove",
      "note": "Dove mass is ~5 kg class; plot 5/15 W values are representative estimates and should be treated as such."
    }
  },
